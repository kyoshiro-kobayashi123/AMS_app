<div class="container mt-4">
  <h2>スケジュール登録</h2>

  <%= form_with model: @time_slot, url: schedules_path, local: true do |f| %>
    <% if @time_slot.errors.any? %>
      <div class="alert alert-danger">
        <ul>
          <% @time_slot.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= f.label :date, "日付", class: "form-label" %>
      <%= f.date_field :date, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :start_time, "開始時間", class: "form-label" %>
      <%= f.time_field :start_time, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :end_time, "終了時間", class: "form-label" %>
      <%= f.time_field :end_time, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :lesson_id, "授業", class: "form-label" %>
      <%= f.collection_select :lesson_id, @lessons, :id, :lesson_name,
          { prompt: "授業を選択してください" },
          { class: "form-select", required: true } %>
    </div>

<div class="mb-3">
      <%= label_tag :selected_faculty_id, "担当教員", class: "form-label" %>
      <%= select_tag :selected_faculty_id, 
          options_from_collection_for_select(@faculties, :id, :name, @selected_faculty_id),
          class: "form-select",
          onchange: "this.form.submit()",
          data: { turbo: false } %>
      <small class="form-text text-muted">教員を選択すると授業リストが更新されます</small>
    </div>

<div class="mb-3">
  <%= f.label :classroom_id, "教室", class: "form-label" %>
  <%= f.collection_select :classroom_id, @classrooms, :id, :room_number,
      { prompt: "教室を選択してください" },
      { class: "form-select", required: true } %>
</div>

    <!-- 選択された教員名を表示 -->
    <% if @selected_faculty_id %>
      <% selected_faculty = Faculty.find_by(@selected_faculty_id) %>
      <div class="alert alert-success mb-3">
        <strong><%= selected_faculty.name.split(/[\s ]/).first %>先生</strong>
      </div>
    <% end %>

    <div class="d-flex gap-2">
      <%= f.submit "登録", class: "btn btn-primary" %>
      <%= link_to "キャンセル", schedules_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>