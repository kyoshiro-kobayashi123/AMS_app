<%# ▼▼▼ ログイン時のみハンバーガーメニューを表示 ▼▼▼ %>
<% if student_signed_in? || faculty_signed_in? %>
  <!-- ハンバーガーボタン -->
  <button class="hamburger" id="js-hamburger">
    <span class="hamburger__line"></span>
    <span class="hamburger__line"></span>
    <span class="hamburger__line"></span>
    <span class="hamburger__text">MENU</span>
  </button>

  <!-- ナビゲーションメニュー -->
  <nav class="header__nav" id="js-nav">
    <ul class="nav-items">
      <%# 学生の場合のメニュー %>
      <% if student_signed_in? %>
        <li class="nav-items__item">
          <%= link_to "出席登録フォームへ", new_attendance_path %>
        </li>
        <li class="nav-items__item">
          <%= link_to "コマ確認へ", schedules_path %>
        </li>
        <li class="nav-items__item">
          <%= link_to "ログアウト", destroy_student_session_path, data: { turbo_method: :delete} %>
        </li>
      <% end %>

      <%# 教職員の場合のメニュー %>
      <% if faculty_signed_in? %>
        <li class="nav-items__item">
          <%= link_to "出席管理画面へ", faculties_attendances_path %>
        </li>
        <li class="nav-items__item">
          <%= link_to "時間割確認へ", schedules_path %>
        </li>
        <li class="nav-items__item">
          <%= link_to "ログアウト", destroy_faculty_session_path, data: { turbo_method: :delete} %>
        </li>
      <% end %>

      <%# 共通メニュー %>
      <li class="nav-items__item">
        <%= link_to "トップページへ", root_path %>
      </li>
    </ul>
  </nav>
<% end %>
<%# ▲▲▲ ここまで ▲▲▲ %>
<div class="container top-page-container">
  <%# ヘッダー部分 %>
  <div class="top-header">
    <h1>📚 出席管理システム</h1>
    <p>対象を選択してログインしてください</p>
  </div>

  <%# --- 1. 学生がログインしている場合 --- %>
  <% if student_signed_in? %>
    <div class="logged-in-box student-logged">
      <h3><%= image_tag "student.png", alt: "学生", style: "width: 40px; height: 40px; vertical-align: middle; margin-right: 10px;" %> ようこそ、<%= current_student.name %> さん</h3>
      <p>学籍番号: <%= current_student.student_number %></p>
      <%= link_to "出席登録フォームへ", new_attendance_path,
          class: "btn btn-danger btn-lg",
          style: "padding: 12px 40px; font-size: 1.1rem;" %>
      <%= link_to "ログアウト", destroy_student_session_path, method: :delete,
          class: "btn btn-danger btn-lg",
          style: "padding: 12px 40px; font-size: 1.1rem;" %>
    </div>

  <%# --- 2. 教職員がログインしている場合 --- %>
  <% elsif faculty_signed_in? %>
    <div class="logged-in-box faculty-logged">
      <h3><%= image_tag "teacher.png", alt: "教職員", style: "width: 40px; height: 40px; vertical-align: middle; margin-right: 10px;" %> ようこそ、<%= current_faculty.try(:name) || "教職員" %> 先生</h3>
      <%= link_to "出席管理画面へ", faculties_attendances_path,
          class: "btn btn-danger btn-lg",
          style: "padding: 12px 40px; font-size: 1.1rem;" %>
      <%= link_to "ログアウト", destroy_faculty_session_path, method: :delete,
          class: "btn btn-danger btn-lg",
          style: "padding: 12px 40px; font-size: 1.1rem;" %>
    </div>

  <%# --- 3. 誰もログインしていない時（ログイン選択画面） --- %>
  <% else %>
    <div class="login-cards">
      <%# 学生用カード %>
      <div class="login-card student">
        <div class="card-icon"><%= image_tag "student.png", alt: "学生", class: "icon-image" %></div>
        <h2 class="card-title">学生の方</h2>
        <p class="card-description">授業の出席登録を行います。<br>学籍番号でログインしてください。</p>
        <%= link_to "学生ログイン", new_student_session_path, class: "login-button student-btn" %>
      </div>

      <%# 教職員用カード %>
      <div class="login-card faculty">
        <div class="card-icon"><%= image_tag "teacher.png", alt: "教職員", class: "icon-image" %></div>
        <h2 class="card-title">教職員の方</h2>
        <p class="card-description">出席状況の確認・管理を行います。<br>教職員IDでログインしてください。</p>
        <%= link_to "教職員ログイン", new_faculty_session_path, class: "login-button faculty-btn" %>
      </div>
    </div>
  <% end %>
</div>
