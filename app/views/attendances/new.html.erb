<% if flash[:notice] %>
  <p style="color: green;"><%= flash[:notice] %></p>
<% end %>
<% if flash[:alert] %>
  <p style="color: red;"><%= flash[:alert] %></p>
<% end %>

<% # 現在ログインしている学生情報を表示（authenticate_student! が成功している前提） %>
<p><strong>ログイン中の学生:</strong> <%= current_student.name %> (<%= current_student.student_number %>)</p>

<hr>

<h1>出席登録</h1>

<h2 style="font-size: 2.5rem; color:rgb(255, 0, 128);">今日の授業</h2>

<% today = Date.current %>
<% TimeSlot.where(date: today).order(:start_time).each do |time_slot| %>
  <div style="border: 1px solid #ccc; padding: 10px; margin-bottom: 15px; line-height: 1.8; position: relative;">
    <h3 style="font-size: 1.5rem; color: green;"><%= time_slot.lesson.lesson_name %></h3>
    <p>
      コマ日付: <%= time_slot.date.strftime('%Y/%m/%d') %><br>
      コマ時間: <%= time_slot.start_time.strftime('%H:%M') %> 〜 <%= time_slot.end_time.strftime('%H:%M') %><br>
      <span style="color:rgb(100, 100, 100);">
        現在の判定時間:
        <%= time_slot.attendance_start_time.strftime('%H:%M') %> (登録開始)
        〜 <%= (time_slot.start_time.to_time + 20.minutes).strftime('%H:%M') %> (遅刻締切)
      </span>
    </p>

    <%= form_with url: attendances_path, method: :post, local: true, data: { turbo: false } do |form| %>
      <%= form.hidden_field :time_slot_id, value: time_slot.id %>

      <div style="margin-bottom: 10px;">
        <%= form.submit "出席登録 (通常/遅刻)", data: { confirm: '出席または遅刻として登録しますか？' }, style: "padding: 10px 20px; font-size: 1rem; background-color: green; color: white; border: none; border-radius: 5px; cursor: pointer;" %>
      </div>

      <p style="position: absolute; top: 10px; right: 10px; margin: 0; text-align: left;">
        <%= form.label :late_reason, style: "color: red;" do %>
          遅刻理由 <span style="font-size: 0.8em;">(遅刻の場合必須)</span>
        <% end %><br>
        <%= form.text_area :late_reason, placeholder: "例: 電車遅延", style: "width: 250px; height: 150px; padding: 5px; font-size: 1rem;" %>
      </p>
    <% end %>
  </div>
<% end %>
