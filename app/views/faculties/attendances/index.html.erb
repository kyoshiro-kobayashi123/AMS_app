<% if notice %>
  <p style="color: green;">✅ <%= notice %></p>
<% end %>
<% if alert %>
  <p style="color: red;">❌ <%= alert %></p>
<% end %>

<hr>

<div style="background-color: white; padding: 20px; border: 1px solid #ccc;">
    <h2 style="margin: 0 0 30px 0; width: 100%; font-size: 2rem; color: #007bff;">出席管理</h2>
    <%= form_with(url: faculties_attendances_path, method: :get, local: true, html: { style: "display: flex; flex-wrap: wrap; align-items: center; gap: 30px;" }) do |form| %>
    <div style="font-size: 1.2rem;">
      <%= form.label :lesson_name, "授業名", style: "margin-right: 10px;" %>
      <%= form.text_field :lesson_name, value: params[:lesson_name], style: "padding: 5px; font-size: 1rem;" %>
    </div>

    <div style="font-size: 1.2rem;">
      <%= form.label :date, "日付", style: "margin-right: 10px;" %>
      <%= form.date_field :date, value: params[:date] || Date.current, style: "padding: 5px; font-size: 1rem;" %>
    </div>

    <%= form.submit "表示", style: "padding: 10px 25px; font-size: 1.1rem; background-color: #007bff; color: white; border: none; border-radius: 5px;" %>
    <% end %>

    <div style="width: 100%; display: flex; align-items: center; gap: 30px; margin-top: 30px; padding-top: 20px; border-top: 1px solid #ccc;">
  <h2 style="margin: 0;">出席状況</h2>

  <ul style="display: flex; list-style: none; padding: 0; margin: 0; gap: 10px; font-size: 1.1rem;">
    <% @json_response[:counts].to_a.reverse.each_with_index do |(status, count), index| %>
      <% label =
        case status
        when 'present'      then '出席'
        when 'late'         then '遅刻'
        when 'early_leave'  then '早退'
        when 'absent'       then '欠席'
        else status.upcase
        end
      %>
      <% color =
        case status
        when 'present'      then 'green'
        when 'late'         then '#e6b800'
        when 'early_leave'  then 'deepskyblue'
        when 'absent'       then 'red'
        else 'inherit'
        end
      %>
      <li style="color: <%= color %>;">
        <strong><%= label %>:</strong>
        <%= count %>件
      </li>
      <% if index < @json_response[:counts].size - 1 %>
        <li>/</li>
      <% end %>
    <% end %>
  </ul>
    </div>

    <div style="width: 100%; padding-top: 20px; border-top: 1px solid #ccc;">
      <table border="1" cellpadding="30" style="width: 100%; border-collapse: collapse; text-align: center;">
  <thead>
    <tr style="font-size: 1.2rem; background-color: #f2f2f2;">
      <th>学生番号</th>
      <th>氏名</th>
      <th>授業</th>
      <th>登録時刻</th>
      <th>ステータス</th>
      <th>理由</th>
      <th>承認状況</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @json_response[:details].each do |att| %>
      <% status       = att[:status] %>
      <% status_label = att[:status_label] || case status
        when 'present'      then '出席'
        when 'late'         then '遅刻'
        when 'early_leave'  then '早退'
        when 'absent'       then '欠席'
        else status
      end %>
      <% color =
        case status
        when 'late'        then 'orange'
        when 'absent'      then 'red'
        when 'early_leave' then 'blue'
        else 'green'
        end
      %>

      <tr>
        <td><%= att[:student_number] %></td>
        <td><%= att[:name] %></td>
        <td><%= att[:lesson_name] %></td>
        <td><%= att[:registered_at] %></td>

        <td>
          <strong style="color: <%= color %>;">
            <%= status_label %>
          </strong>
        </td>

        <td><%= att[:late_reason] %></td>

        <td><%= att[:admin_approval] ? '✅ 承認済' : '❌ 未承認' %></td>

        <td>
          <%
            # 利用可能な操作を収集
            actions = []
            if status == 'late' && !att[:admin_approval]
              actions << { label: "遅刻承認", params: { admin_approval: true }, style: "background: yellowgreen; border: none; padding: 10px 20px; margin: 5px; border-radius: 5px;" }
            end
            if %w[present late].include?(status)
              actions << { label: "早退にする", params: { status: 'early_leave' }, style: "background: lightskyblue; border: none; padding: 10px 20px; margin: 5px; border-radius: 5px;" }
            end
            if status != 'absent'
              actions << { label: "欠席にする", params: { status: 'absent' }, style: "background: salmon; border: none; padding: 10px 20px; margin: 5px; border-radius: 5px;" }
            end
            if status != 'present'
              actions << { label: "出席にする", params: { status: 'present' }, style: "background: lightgreen; border: none; padding: 10px 20px; margin: 5px; border-radius: 5px;" }
            end
          %>

          <% if actions.size > 1 %>
            <%# 複数の操作が可能な場合はセレクトボックスを表示 %>
            <%= form_with(url: faculties_attendance_path(att[:id]), method: :patch, local: true, class: "attendance-update-form") do |form| %>
              <div class="dynamic-hidden-fields" style="display: none;"></div>
              <select name="action" onchange="this.form.dispatchEvent(new CustomEvent('submitAction', { bubbles: true, detail: { select: this } }))" style="padding: 10px; margin: 5px; font-size: 1rem;">
                <option value="" selected disabled>変更</option>
                <% actions.each do |action| %>
                  <option value='<%= action[:params].to_json.encode(xml: :attr) %>'><%= action[:label] %></option>
                <% end %>
              </select>
            <% end %>
          <% elsif actions.size == 1 %>
            <%# 操作が1つの場合はボタンを表示 %>
            <% action = actions.first %>
            <%= form_with(url: faculties_attendance_path(att[:id]), method: :patch, local: true) do |form| %>
              <% action[:params].each do |key, value| %>
                <%= form.hidden_field key, value: value %>
              <% end %>
              <%= form.submit action[:label], style: action[:style] %>
            <% end %>
          <% else %>
            -
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
    </div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.attendance-update-form').forEach(form => {
    form.addEventListener('submitAction', function(event) {
      const selectElement = event.detail.select;
      const jsonParams = selectElement.value;
      if (!jsonParams) return;

      const params = JSON.parse(jsonParams);
      const hiddenFieldsContainer = form.querySelector('.dynamic-hidden-fields');
      hiddenFieldsContainer.innerHTML = ''; // 以前のフィールドをクリア

      // パラメータに基づいて隠しフィールドを動的に生成
      Object.keys(params).forEach(key => {
        const hiddenField = document.createElement('input');
        hiddenField.type = 'hidden';
        hiddenField.name = key;
        hiddenField.value = params[key];
        hiddenFieldsContainer.appendChild(hiddenField);
      });

      form.submit();
    });
  });
});
</script>
</div>
